# RAG 系统环境变量配置示例
# 复制本文件为 .env 并填入实际值

# ---------- LLM 配置（OpenAI 兼容接口）----------
# 通义千问示例:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek 示例:  LLM_BASE_URL=https://api.deepseek.com/v1
# 本地 Ollama:    LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.3

# ---------- 文本切分 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- 检索 ----------
SEARCH_TOP_K=4

# ---------- API 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
